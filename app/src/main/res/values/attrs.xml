<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================= -->
    <!-- PAGE 0 — Custom theme attributes (semantic, config-aware)      -->
    <!-- ============================================================= -->
    <attr name="themeBackground" format="color|reference" />
    <attr name="themeTextPrimary" format="color|reference" />
    <attr name="themeTextSecondary" format="color|reference" />
    <attr name="themeSurfaceVariant" format="color|reference" />
    <attr name="themeDivider" format="color|reference" />
    <attr name="themePrimary" format="color|reference" />
    <attr name="themeLike" format="color|reference" />
    <attr name="themeSheet" format="color|reference" />

    <!-- StoryRingView attributes -->
    <declare-styleable name="StoryRingView">
        <attr name="ringState" format="enum">
            <enum name="none" value="0" />
            <enum name="unseen" value="1" />
            <enum name="seen" value="2" />
        </attr>
        <attr name="ringStrokeWidth" format="dimension" />
        <attr name="gapWidth" format="dimension" />
    </declare-styleable>

    <!-- WordmarkView attributes -->
    <declare-styleable name="WordmarkView">
        <attr name="android:textSize" />
        <attr name="android:textColor" />
        <attr name="wordmarkSize">
            <enum name="top_bar" value="0" />
            <enum name="login" value="1" />
            <enum name="welcome" value="2" />
        </attr>
    </declare-styleable>
</resources>
