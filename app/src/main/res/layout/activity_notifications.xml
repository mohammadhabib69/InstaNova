<?xml version="1.0" encoding="utf-8"?>
<!-- Activity feed: grouped notifications (New / Today / This week). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/notifTopBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/notif_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/themeTextPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/notifications"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_hairline"
        android:background="?attr/themeDivider" />

    <TextView
        android:id="@+id/tvFollowRequests"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/settings_row_pad_h"
        android:paddingEnd="@dimen/settings_row_pad_h"
        android:text="@string/st_follow_requests"
        android:textColor="@color/color_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Shown when the OS is blocking this app's notifications. Without it the
         screen looks healthy while every push is dropped silently. -->
    <LinearLayout
        android:id="@+id/boxNotificationsOff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/themeSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/settings_row_pad_h"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/settings_row_pad_h"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notifications_off_body"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnEnableNotifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp"
            android:text="@string/notifications_off_action"
            android:textColor="@color/color_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/emptyNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/notifications"
                android:src="@drawable/ic_heart"
                app:tint="?attr/themeTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/notifications_empty_title"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/notifications_empty_subtitle"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
