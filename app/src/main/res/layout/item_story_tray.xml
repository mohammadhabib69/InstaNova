<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/story_item_width"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="4dp">

    <FrameLayout
        android:layout_width="@dimen/story_avatar_size"
        android:layout_height="@dimen/story_avatar_size">

        <com.insta.clone.ui.widget.StoryRingView
            android:id="@+id/storyRingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:gapWidth="@dimen/story_ring_gap"
            app:ringState="unseen"
            app:ringStrokeWidth="@dimen/story_ring_stroke_unseen" />

        <!-- Add Story Plus Badge for current user -->
        <ImageView
            android:id="@+id/ivAddBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_story_add_badge"
            android:padding="3dp"
            android:src="@drawable/ic_add_box"
            app:tint="@color/white"
            android:visibility="gone"
            android:contentDescription="Add story" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="?attr/themeTextSecondary"
        android:textSize="@dimen/text_meta" />

</LinearLayout>
