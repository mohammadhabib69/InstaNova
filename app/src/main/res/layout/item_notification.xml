<?xml version="1.0" encoding="utf-8"?>
<!-- One activity row: actor, rich sentence + time, post thumb / Follow, unseen dot. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="@dimen/notif_row_padding_horizontal"
    android:paddingTop="@dimen/notif_row_padding_vertical"
    android:paddingEnd="@dimen/notif_row_padding_horizontal"
    android:paddingBottom="@dimen/notif_row_padding_vertical">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivActorAvatar"
        android:layout_width="@dimen/notif_avatar"
        android:layout_height="@dimen/notif_avatar"
        android:src="@drawable/ic_person_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvNotificationText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/notif_avatar_gap"
        android:layout_marginEnd="@dimen/notif_avatar_gap"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.1"
        android:maxLines="4"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="@dimen/notif_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layoutRight"
        app:layout_constraintStart_toEndOf="@id/ivActorAvatar"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPostThumb"
            android:layout_width="@dimen/notif_thumb"
            android:layout_height="@dimen/notif_thumb"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Insta.NotificationThumb" />

        <TextView
            android:id="@+id/btnFollow"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/notif_follow_height"
            android:background="@drawable/bg_notification_follow"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="@dimen/notif_follow_padding_horizontal"
            android:paddingEnd="@dimen/notif_follow_padding_horizontal"
            android:text="@string/notification_follow"
            android:textColor="@color/white"
            android:textSize="@dimen/notif_follow_text_size"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:id="@+id/vUnreadDot"
            android:layout_width="@dimen/notif_unread_dot"
            android:layout_height="@dimen/notif_unread_dot"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_notification_dot"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
