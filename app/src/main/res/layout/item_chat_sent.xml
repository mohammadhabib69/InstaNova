<?xml version="1.0" encoding="utf-8"?>
<!-- PAGE 17 — sent bubble: right aligned, 8dp from the right edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="64dp"
    android:paddingEnd="@dimen/chat_sent_margin_end">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivError"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retry sending"
            android:src="@drawable/ic_error"
            android:visibility="gone"
            app:tint="@color/color_destructive" />

        <FrameLayout
            android:id="@+id/layoutBubbleWrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/layoutBubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_bubble_sent"
                android:orientation="vertical"
                android:paddingStart="@dimen/chat_bubble_padding_horizontal"
                android:paddingTop="@dimen/chat_bubble_padding_vertical"
                android:paddingEnd="@dimen/chat_bubble_padding_horizontal"
                android:paddingBottom="@dimen/chat_bubble_padding_vertical">

                <!-- Quoted Reply Header -->
                <LinearLayout
                    android:id="@+id/layoutQuotedReply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_chat_reply_box"
                    android:orientation="horizontal"
                    android:padding="6dp"
                    android:visibility="gone">

                    <View
                        android:id="@+id/viewReplyIndicator"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvReplyUser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvReplyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Sent Image -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivMessageImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="Photo"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Insta.ChatMedia" />

                <!-- Sent Voice Message -->
                <LinearLayout
                    android:id="@+id/layoutVoiceMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:minWidth="170dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/btnVoicePlay"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Play voice message"
                        android:src="@drawable/ic_play"
                        app:tint="@color/white" />

                    <ProgressBar
                        android:id="@+id/progressVoice"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="85dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/white" />

                    <TextView
                        android:id="@+id/tvVoiceDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Call Entry (Audio / Video Call) -->
                <LinearLayout
                    android:id="@+id/layoutCallMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivCallIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_phone_call"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCallTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Audio call"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCallSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Call ended"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Text Message -->
                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/chat_bubble_text_size" />
            </LinearLayout>

            <!-- Reaction Pill -->
            <LinearLayout
                android:id="@+id/layoutReactionPill"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/chat_reaction_height"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="@dimen/chat_reaction_offset_start"
                android:background="@drawable/bg_chat_reaction_pill"
                android:gravity="center"
                android:minWidth="@dimen/chat_reaction_min_width"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:visibility="gone"
                android:translationY="@dimen/chat_reaction_overlap">

                <TextView
                    android:id="@+id/tvReactions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="@dimen/chat_reaction_emoji_size" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
