<?xml version="1.0" encoding="utf-8"?>
<!-- PAGE 14 — Account privacy: title + switch, then the two explanatory paragraphs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/settings_row_pad_h"
        android:paddingEnd="@dimen/settings_row_pad_h">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/settings_back_icon"
            android:layout_height="@dimen/settings_back_icon"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/settings_cancel"
            app:tint="?attr/themeTextPrimary" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/settings_row_icon_gap"
            android:text="@string/settings_account_privacy"
            android:textAppearance="@style/TextAppearance.Insta.SettingsTitle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/privacy_row_pad">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_private_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/story_vw_private_account"
                    android:textAppearance="@style/TextAppearance.Insta.PrivacyTitle" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_private"
                    android:layout_width="@dimen/privacy_switch_width"
                    android:layout_height="@dimen/privacy_switch_height"
                    android:layout_marginStart="@dimen/privacy_switch_gap"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_public_paragraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/privacy_switch_gap"
                android:text="@string/privacy_public_body"
                android:textAppearance="@style/TextAppearance.Insta.PrivacyBody" />

            <TextView
                android:id="@+id/tv_private_paragraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/privacy_switch_gap"
                android:text="@string/privacy_private_body"
                android:textAppearance="@style/TextAppearance.Insta.PrivacyBody" />

            <LinearLayout
                android:id="@+id/layout_locked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/privacy_switch_gap"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="@dimen/privacy_lock_circle"
                    android:layout_height="@dimen/privacy_lock_circle"
                    android:background="@drawable/bg_circle_outline">

                    <ImageView
                        android:layout_width="@dimen/privacy_lock_icon"
                        android:layout_height="@dimen/privacy_lock_icon"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@null"
                        app:tint="?attr/themeTextPrimary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_locked_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/privacy_switch_gap"
                    android:text="@string/privacy_locked_title"
                    android:textStyle="bold"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="@dimen/privacy_lock_title_size" />

                <TextView
                    android:id="@+id/tv_locked_body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/privacy_locked_body"
                    android:textAppearance="@style/TextAppearance.Insta.PrivacyBody" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
