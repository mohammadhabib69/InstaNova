<?xml version="1.0" encoding="utf-8"?>
<!--
    Instagram-style comments sheet: drag handle, centred title, scrollable thread,
    and the composer pinned to the bottom. Theme-aware surfaces only.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/commentsSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="@dimen/create_sheet_handle_width"
        android:layout_height="@dimen/create_sheet_handle_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/create_sheet_handle_margin_top"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/comments_title_height"
        android:gravity="center"
        android:text="@string/comments"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_hairline"
        android:background="?attr/themeDivider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvComments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="@dimen/comments_list_padding_vertical"
            android:paddingBottom="@dimen/comments_list_padding_vertical" />

        <ProgressBar
            android:id="@+id/progressComments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="?attr/themeTextSecondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/emptyComments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comments_empty_title"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/comments_empty_subtitle"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_hairline"
        android:background="?attr/themeDivider" />

    <LinearLayout
        android:id="@+id/layoutCommentInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/comments_input_padding_horizontal"
        android:paddingTop="@dimen/comments_input_padding_vertical"
        android:paddingEnd="@dimen/comments_input_padding_horizontal"
        android:paddingBottom="@dimen/comments_input_padding_vertical">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivMyAvatar"
            android:layout_width="@dimen/comments_my_avatar"
            android:layout_height="@dimen/comments_my_avatar"
            android:src="@drawable/ic_person_placeholder" />

        <EditText
            android:id="@+id/etCommentInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/comments_input_gap"
            android:layout_marginEnd="@dimen/comments_input_gap"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/add_a_comment"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="@dimen/comments_input_min_height"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="?attr/themeTextPrimary"
            android:textColorHint="?attr/themeTextSecondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/btnPostComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.45"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:text="@string/post"
            android:textColor="?attr/themePrimary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
