<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Sheet Header (Comments Title + Divider) -->
    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="@string/comments"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/themeDivider" />

    <!-- Scrollable Comments List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvComments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/themeDivider" />

    <!-- 8 Quick Emoji Pills Horizontal Bar (PRD 6.7) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:paddingVertical="6dp"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:id="@+id/layoutEmojiBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/emojiHeart"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="❤️"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/emojiHands"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="🙌"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/emojiFire"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="🔥"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/emojiClap"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="👏"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/emojiCry"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="😢"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/emojiLove"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="😍"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/emojiSurprise"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="😮"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/emojiLaugh"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="😂"
                android:textSize="22sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Sticky Bottom Comment Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivMyAvatar"
            android:layout_width="@dimen/avatar_feed_header"
            android:layout_height="@dimen/avatar_feed_header"
            android:src="@drawable/ic_person_placeholder" />

        <EditText
            android:id="@+id/etCommentInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="12dp"
            android:background="@null"
            android:hint="@string/add_a_comment"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:textColor="?attr/themeTextPrimary"
            android:textColorHint="?attr/themeTextSecondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/btnPostComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:padding="6dp"
            android:text="@string/post"
            android:textColor="?attr/themePrimary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
