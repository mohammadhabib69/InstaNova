<?xml version="1.0" encoding="utf-8"?>
<!-- Template editor: photo, template fields, preview and the two share paths. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnEditorClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/themeTextPrimary" />

        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingEnd="24dp"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_hairline"
        android:background="?attr/themeDivider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/ivTemplatePhoto"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="?attr/themeSurfaceVariant"
                android:contentDescription="@string/templates_add_photo"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_photo_library" />

            <TextView
                android:id="@+id/btnPickPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:text="@string/templates_add_photo"
                android:textColor="?attr/themePrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/fieldsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnTemplatePreview"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/templates_preview"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="@dimen/text_button"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnShareAsPost"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="@string/templates_share_post"
                android:textColor="@color/white"
                android:textSize="@dimen/text_button"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnShareAsStory"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:gravity="center"
                android:text="@string/templates_share_story"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="@dimen/text_button"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
