<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackground"
    android:paddingHorizontal="24dp">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="?attr/themeTextPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Back" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/signup_title_password"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="@dimen/text_auth_title"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivBack" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/signup_subtitle_password"
        android:textColor="?attr/themeTextSecondary"
        android:textSize="@dimen/text_body"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <FrameLayout
        android:id="@+id/layoutPassword"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_field_height"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_input_field"
            android:hint="@string/login_hint_password"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            android:textColor="?attr/themeTextPrimary"
            android:textColorHint="?attr/themeTextSecondary"
            android:textSize="@dimen/text_body" />

        <ImageView
            android:id="@+id/ivPasswordToggle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_visibility"
            android:contentDescription="Toggle password visibility" />
    </FrameLayout>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_auth_height"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_button_primary"
        android:text="@string/next"
        android:textColor="@color/white"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/layoutPassword" />

</androidx.constraintlayout.widget.ConstraintLayout>
