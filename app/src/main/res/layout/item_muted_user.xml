<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nova_card"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/nova_cd_avatar"
        android:src="@drawable/ic_person_circle" />

    <TextView
        android:id="@+id/username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/nova_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/chipPosts"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_nova_chip_off"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/nova_posts"
        android:textColor="@color/nova_text_2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/chipStories"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_nova_chip_off"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/nova_stories"
        android:textColor="@color/nova_text_2"
        android:textSize="12sp" />
</LinearLayout>
