<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 5 — What's your birthday? (reference image 5) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topbar"
        layout="@layout/view_wizard_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_side_padding"
            android:paddingEnd="@dimen/auth_side_padding">

            <TextView
                android:id="@+id/tv_title"
                style="@style/TextAppearance.Insta.AuthTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_title_gap"
                android:text="@string/auth_birthday_title" />

            <!-- Subtitle carries the bold 'Why do I need to provide my birthday?' link. -->
            <TextView
                android:id="@+id/tv_subtitle"
                style="@style/TextAppearance.Insta.AuthSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_subtitle_gap" />

            <com.insta.nova.ui.auth.AuthFieldView
                android:id="@+id/field_birthday"
                style="@style/Widget.Insta.AuthField.Birthday"
                android:layout_marginTop="@dimen/auth_title_gap" />

            <!-- Instruction for the "no date picked yet" state. Secondary colour, so it
                 reads as guidance rather than as an error, and it is why Next is dim. -->
            <TextView
                android:id="@+id/tv_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/auth_birthday_required"
                android:textColor="@color/auth_text_secondary"
                android:textSize="@dimen/auth_code_error_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_error"
                style="@style/TextAppearance.Insta.AuthInlineError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                android:layout_marginTop="@dimen/auth_button_gap">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_primary"
                    style="@style/Widget.Insta.AuthButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/auth_next" />

                <ProgressBar
                    android:id="@+id/progress_primary"
                    android:layout_width="@dimen/auth_button_spinner"
                    android:layout_height="@dimen/auth_button_spinner"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/auth_on_primary"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_bottom_link"
        style="@style/Widget.Insta.AuthBottomLink"
        android:layout_gravity="center_horizontal"
        android:text="@string/auth_already_have_account" />
</LinearLayout>
