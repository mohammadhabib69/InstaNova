<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 3 — Enter the confirmation code (reference images 1 and 10) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topbar"
        layout="@layout/view_wizard_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_side_padding"
            android:paddingEnd="@dimen/auth_side_padding">

            <TextView
                android:id="@+id/tv_title"
                style="@style/TextAppearance.Insta.AuthTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_title_gap"
                android:text="@string/auth_code_title" />

            <TextView
                android:id="@+id/tv_subtitle"
                style="@style/TextAppearance.Insta.AuthSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_subtitle_gap" />

            <!--
              Six boxes spanning the width, driven by one transparent EditText laid
              over them, so the numeric keyboard opens on tap and paste fills all.
            -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_code_box_height"
                android:layout_marginTop="@dimen/auth_title_gap">

                <LinearLayout
                    android:id="@+id/layout_code_boxes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/box_1"
                        style="@style/Widget.Insta.AuthCodeBox"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/box_2"
                        style="@style/Widget.Insta.AuthCodeBox"
                        android:layout_marginStart="@dimen/auth_code_box_gap"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/box_3"
                        style="@style/Widget.Insta.AuthCodeBox"
                        android:layout_marginStart="@dimen/auth_code_box_gap"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/box_4"
                        style="@style/Widget.Insta.AuthCodeBox"
                        android:layout_marginStart="@dimen/auth_code_box_gap"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/box_5"
                        style="@style/Widget.Insta.AuthCodeBox"
                        android:layout_marginStart="@dimen/auth_code_box_gap"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/box_6"
                        style="@style/Widget.Insta.AuthCodeBox"
                        android:layout_marginStart="@dimen/auth_code_box_gap"
                        android:layout_weight="1" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_code_input"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:digits="0123456789"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textColor="@android:color/transparent"
                    android:textSize="1sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_error"
                style="@style/TextAppearance.Insta.AuthInlineError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_code_error_gap"
                android:text="@string/auth_code_wrong"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                android:layout_marginTop="@dimen/auth_button_gap">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_primary"
                    style="@style/Widget.Insta.AuthButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/auth_next" />

                <ProgressBar
                    android:id="@+id/progress_primary"
                    android:layout_width="@dimen/auth_button_spinner"
                    android:layout_height="@dimen/auth_button_spinner"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/auth_on_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_secondary"
                style="@style/Widget.Insta.AuthButton.Secondary"
                android:layout_marginTop="@dimen/auth_button_gap_secondary"
                android:text="@string/auth_code_didnt_get" />
        </LinearLayout>
    </ScrollView>
    <!-- No bottom 'I already have an account' link on this screen, per the reference. -->
</LinearLayout>
