<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 3 — Confirm your email address (Firebase verification link, not a code) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topbar"
        layout="@layout/view_wizard_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_side_padding"
            android:paddingEnd="@dimen/auth_side_padding">

            <TextView
                android:id="@+id/tv_title"
                style="@style/TextAppearance.Insta.AuthTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_title_gap"
                android:text="@string/auth_verify_title" />

            <TextView
                android:id="@+id/tv_subtitle"
                style="@style/TextAppearance.Insta.AuthSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_subtitle_gap" />

            <!--
              Status panel. Firebase Auth has no email OTP, so instead of six boxes
              that would accept meaningless digits this shows the live state of the
              confirmation link and polls Firebase until it has been opened.
            -->
            <LinearLayout
                android:id="@+id/layout_waiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_title_gap"
                android:background="@drawable/bg_auth_field"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ProgressBar
                    android:id="@+id/progress_waiting"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminateTint="@color/auth_link" />

                <TextView
                    android:id="@+id/tv_waiting"
                    style="@style/TextAppearance.Insta.AuthSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/auth_verify_waiting" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_error"
                style="@style/TextAppearance.Insta.AuthInlineError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_code_error_gap"
                android:text="@string/auth_verify_not_yet"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/auth_button_height"
                android:layout_marginTop="@dimen/auth_button_gap">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_primary"
                    style="@style/Widget.Insta.AuthButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/auth_verify_primary" />

                <ProgressBar
                    android:id="@+id/progress_primary"
                    android:layout_width="@dimen/auth_button_spinner"
                    android:layout_height="@dimen/auth_button_spinner"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/auth_on_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_secondary"
                style="@style/Widget.Insta.AuthButton.Secondary"
                android:layout_marginTop="@dimen/auth_button_gap_secondary"
                android:text="@string/auth_verify_didnt_get" />
        </LinearLayout>
    </ScrollView>
    <!-- No bottom 'I already have an account' link on this screen, per the reference. -->
</LinearLayout>
