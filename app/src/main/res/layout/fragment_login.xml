<?xml version="1.0" encoding="utf-8"?>
<!-- PAGE 16 — Screen B: login form. 1080px @2.75 => dp = px/2.75. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <!--
      A single vertical flow owns the form. The weighted spacer reproduces the
      original bottom placement when the keyboard is closed and collapses first
      when adjustResize reduces the viewport, so the screen can scroll instead of
      letting the bottom group overlap the fields.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Language row, centred ~90dp from the top -->
        <LinearLayout
            android:id="@+id/languageRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="78dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tvLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_language"
                android:textColor="@color/auth_text_secondary"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/ivLanguageChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/auth_text_secondary" />
        </LinearLayout>

        <!-- Nova star glyph, 55dp, centred at ~227dp -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="91dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_logo_mark_filled_gradient" />

        <!-- Field 1 at ~372dp -->
        <EditText
            android:id="@+id/etIdentifier"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="90dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_auth_field"
            android:gravity="center_vertical|start"
            android:hint="@string/login_identifier_hint"
            android:imeOptions="actionNext"
            android:includeFontPadding="false"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingTop="0dp"
            android:paddingEnd="16dp"
            android:paddingBottom="0dp"
            android:singleLine="true"
            android:textColor="@color/auth_text"
            android:textColorHint="@color/auth_text_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvIdentifierError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="18dp"
            android:textColor="@color/auth_field_border_error"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Field 2: password -->
        <FrameLayout
            android:id="@+id/passwordBox"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_auth_field"
                android:gravity="center_vertical|start"
                android:hint="@string/login_password_hint"
                android:imeOptions="actionDone"
                android:includeFontPadding="false"
                android:inputType="textPassword"
                android:maxLines="1"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingTop="0dp"
                android:paddingEnd="48dp"
                android:paddingBottom="0dp"
                android:singleLine="true"
                android:textColor="@color/auth_text"
                android:textColorHint="@color/auth_text_secondary"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/ivPasswordToggle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/login_password_hint"
                android:src="@drawable/ic_visibility"
                android:visibility="gone"
                app:tint="@color/auth_text_secondary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvPasswordError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="18dp"
            android:textColor="@color/auth_field_border_error"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Log in pill -->
        <FrameLayout
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_auth_button_primary"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvLoginLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="@string/login_action"
                android:textColor="@color/auth_on_primary"
                android:textSize="17sp" />

            <ProgressBar
                android:id="@+id/loginSpinner"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/auth_on_primary"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:padding="6dp"
            android:text="@string/login_forgot"
            android:textColor="@color/auth_text"
            android:textSize="17sp" />

        <!-- Absorbs the spare height when closed; collapses before content scrolls. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/btnCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_page16_outline_pill"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="@string/login_create_account"
                android:textColor="@color/auth_outline"
                android:textSize="17sp" />
        </FrameLayout>

        <!-- Bottom branding -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/login_footer"
            android:textColor="@color/auth_text"
            android:textSize="22sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
