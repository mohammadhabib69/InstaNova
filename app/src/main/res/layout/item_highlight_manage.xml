<?xml version="1.0" encoding="utf-8"?>
<!-- One slide already inside a highlight, with a remove control. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="4dp"
    android:background="?attr/themeSurfaceVariant">

    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Highlight story"
        android:scaleType="centerCrop" />

    <ImageButton
        android:id="@+id/btnRemoveItem"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/bg_highlight_more"
        android:contentDescription="Remove this story"
        android:padding="7dp"
        android:src="@drawable/ic_close"
        android:tint="#FFFFFF" />
</FrameLayout>
