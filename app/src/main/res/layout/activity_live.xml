<?xml version="1.0" encoding="utf-8"?>
<!--
    Live (simulated) — one activity, two states:
      setupPanel  : camera preview + optional topic + Start Live
      streamPanel : full-screen feed + LIVE badge + viewers + End
    The camera session is bound once for the activity lifetime and handed to
    CameraX's lifecycle owner, so switching states never rebinds it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/liveRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- TextureView-backed preview: overlays animate reliably above it. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <!-- Covers the preview until the first camera frame is bound. -->
    <View
        android:id="@+id/cameraBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/live_scrim_top_height"
        android:layout_gravity="top"
        android:background="@drawable/bg_live_scrim_top" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/live_scrim_bottom_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_live_scrim_bottom" />

    <!-- ========================================================= -->
    <!-- STATE 1 — Go Live setup                                    -->
    <!-- ========================================================= -->
    <FrameLayout
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/setupTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/live_top_bar_padding"
            android:paddingTop="@dimen/live_top_bar_padding"
            android:paddingEnd="@dimen/live_top_bar_padding"
            android:paddingBottom="@dimen/live_top_bar_padding">

            <ImageView
                android:id="@+id/btnCloseSetup"
                android:layout_width="@dimen/live_circle_button"
                android:layout_height="@dimen/live_circle_button"
                android:background="@drawable/bg_live_glass_circle"
                android:clickable="true"
                android:contentDescription="@string/live_setup_close"
                android:focusable="true"
                android:padding="@dimen/live_circle_icon_padding"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/live_setup_title"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <!-- Balances the close button so the title stays centred. -->
            <Space
                android:layout_width="@dimen/live_circle_button"
                android:layout_height="@dimen/live_circle_button" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/setupBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="@dimen/live_setup_padding_horizontal"
            android:paddingEnd="@dimen/live_setup_padding_horizontal"
            android:paddingBottom="@dimen/live_setup_padding_bottom">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/live_setup_heading"
                android:textColor="@color/white"
                android:textSize="@dimen/live_setup_heading_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/live_setup_subtitle_gap"
                android:text="@string/live_setup_subtitle"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/text_body" />

            <EditText
                android:id="@+id/etLiveTopic"
                android:layout_width="match_parent"
                android:layout_height="@dimen/live_field_height"
                android:layout_marginTop="@dimen/live_field_gap"
                android:background="@drawable/bg_live_topic_field"
                android:contentDescription="@string/live_topic_content_description"
                android:gravity="center_vertical"
                android:hint="@string/live_topic_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="60"
                android:maxLines="1"
                android:paddingStart="@dimen/live_field_padding_horizontal"
                android:paddingEnd="@dimen/live_field_padding_horizontal"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="#99FFFFFF"
                android:textSize="@dimen/live_field_text_size" />

            <TextView
                android:id="@+id/btnStartLive"
                android:layout_width="match_parent"
                android:layout_height="@dimen/live_start_height"
                android:layout_marginTop="@dimen/live_start_gap"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/live_start"
                android:textColor="@color/white"
                android:textSize="@dimen/live_start_text_size"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/live_note_gap"
                android:gravity="center"
                android:text="@string/live_setup_note"
                android:textColor="#99FFFFFF"
                android:textSize="@dimen/live_note_size" />
        </LinearLayout>
    </FrameLayout>

    <!-- ========================================================= -->
    <!-- STATE 2 — live stream chrome                               -->
    <!-- ========================================================= -->
    <FrameLayout
        android:id="@+id/streamPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/streamTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:paddingStart="@dimen/live_top_bar_padding"
            android:paddingTop="@dimen/live_top_bar_padding"
            android:paddingEnd="@dimen/live_top_bar_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/liveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/live_badge_height"
                    android:background="@drawable/bg_live_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/live_badge_padding_horizontal"
                    android:paddingEnd="@dimen/live_badge_padding_horizontal">

                    <View
                        android:id="@+id/liveDot"
                        android:layout_width="@dimen/live_dot_size"
                        android:layout_height="@dimen/live_dot_size"
                        android:background="@drawable/bg_live_dot" />

                    <TextView
                        android:id="@+id/tvLiveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/live_dot_gap"
                        android:letterSpacing="0.08"
                        android:text="@string/live_badge"
                        android:textColor="@color/white"
                        android:textSize="@dimen/live_badge_text_size"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLiveTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/live_timer_gap"
                    android:contentDescription="@string/live_timer_content_description"
                    android:text="@string/live_timer_zero"
                    android:textColor="@color/white"
                    android:textSize="@dimen/live_timer_size" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnEndLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_live_glass_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="@dimen/live_end_padding_horizontal"
                    android:paddingTop="@dimen/live_pill_padding_vertical"
                    android:paddingEnd="@dimen/live_end_padding_horizontal"
                    android:paddingBottom="@dimen/live_pill_padding_vertical"
                    android:text="@string/live_end"
                    android:textColor="@color/white"
                    android:textSize="@dimen/live_end_text_size"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvViewerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/live_viewers_gap"
                android:background="@drawable/bg_live_glass_pill"
                android:contentDescription="@string/live_viewers_content_description"
                android:paddingStart="@dimen/live_pill_padding_horizontal"
                android:paddingTop="@dimen/live_pill_padding_vertical"
                android:paddingEnd="@dimen/live_pill_padding_horizontal"
                android:paddingBottom="@dimen/live_pill_padding_vertical"
                android:text="@string/live_viewers_initial"
                android:textColor="@color/white"
                android:textSize="@dimen/live_viewers_text_size" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/streamBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="@dimen/live_comments_padding_horizontal"
            android:paddingEnd="@dimen/live_comments_padding_horizontal"
            android:paddingBottom="@dimen/live_comments_padding_bottom">

            <TextView
                android:id="@+id/tvLiveTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/live_title_gap"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="@dimen/live_title_size"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/commentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </FrameLayout>

    <!-- Non-blocking camera failure pill (tap to retry). -->
    <TextView
        android:id="@+id/btnCameraError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="@dimen/live_error_gap"
        android:background="@drawable/bg_live_glass_pill"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="@dimen/live_pill_padding_horizontal"
        android:paddingTop="@dimen/live_pill_padding_vertical"
        android:paddingEnd="@dimen/live_pill_padding_horizontal"
        android:paddingBottom="@dimen/live_pill_padding_vertical"
        android:text="@string/live_camera_error"
        android:textColor="@color/white"
        android:textSize="@dimen/live_viewers_text_size"
        android:visibility="gone" />

    <!-- ========================================================= -->
    <!-- Camera permission gate                                     -->
    <!-- ========================================================= -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/live_permission_padding"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPermissionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/live_permission_title"
            android:textColor="@color/white"
            android:textSize="@dimen/live_permission_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPermissionMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/live_viewers_gap"
            android:gravity="center"
            android:text="@string/live_permission_message"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/btnGrantCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/live_field_gap"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="180dp"
            android:paddingStart="@dimen/live_setup_padding_horizontal"
            android:paddingTop="@dimen/live_pill_padding_vertical"
            android:paddingEnd="@dimen/live_setup_padding_horizontal"
            android:paddingBottom="@dimen/live_pill_padding_vertical"
            android:text="@string/live_permission_allow"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPermissionNotNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/live_note_gap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/live_pill_padding_vertical"
            android:text="@string/live_permission_not_now"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/text_body" />
    </LinearLayout>
</FrameLayout>
