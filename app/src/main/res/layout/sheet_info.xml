<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared explanatory bottom sheet. Every 'Learn more' / info link in the
  registration wizard opens one of these instead of being a dead link.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_drag_handle" />

    <TextView
        android:id="@+id/tv_info_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="@dimen/auth_side_padding"
        android:paddingEnd="@dimen/auth_side_padding"
        android:textColor="@color/auth_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_info_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.25"
        android:paddingStart="@dimen/auth_side_padding"
        android:paddingEnd="@dimen/auth_side_padding"
        android:textColor="@color/auth_text_secondary"
        android:textSize="14sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_info_ok"
        style="@style/Widget.Insta.AuthBottomLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/auth_ok" />
</LinearLayout>
