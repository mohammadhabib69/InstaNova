<?xml version="1.0" encoding="utf-8"?>
<!--
  PAGE 11 — Story editor / share. Background gradient + card size are computed in
  Java from the picked bitmap, so only the structure lives here.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/story_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Gradient built from the picked image (average colour +/- lighten/darken). -->
    <View
        android:id="@+id/view_editor_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bottom 96dp is solid black. -->
    <View
        android:id="@+id/view_bottom_band"
        android:layout_width="match_parent"
        android:layout_height="@dimen/story_ed_bottom_solid"
        android:layout_gravity="bottom"
        android:background="@color/black" />

    <!-- Top row: close (left) + six 40dp circles (right). -->
    <LinearLayout
        android:id="@+id/layout_editor_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/story_ed_top_gap"
        android:paddingStart="@dimen/story_ed_top_margin"
        android:paddingEnd="@dimen/story_ed_top_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_editor_close"
            style="@style/Widget.Insta.StoryCircleButton"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/delete" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_editor_draw"
            style="@style/Widget.Insta.StoryCircleButton"
            android:src="@drawable/ic_draw"
            android:contentDescription="@string/story_ed_done" />

        <ImageView
            android:id="@+id/btn_editor_tag"
            style="@style/Widget.Insta.StoryCircleButton"
            android:layout_marginStart="@dimen/story_ed_top_gap"
            android:src="@drawable/ic_tag_person"
            android:contentDescription="@string/story_ed_add_text" />

        <TextView
            android:id="@+id/btn_editor_text"
            android:layout_width="@dimen/story_ed_circle"
            android:layout_height="@dimen/story_ed_circle"
            android:layout_marginStart="@dimen/story_ed_top_gap"
            android:background="@drawable/bg_story_scrim_circle"
            android:gravity="center"
            android:text="@string/story_ed_aa"
            android:textColor="@color/white"
            android:textSize="@dimen/story_ed_text_glyph"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_editor_sticker"
            style="@style/Widget.Insta.StoryCircleButton"
            android:layout_marginStart="@dimen/story_ed_top_gap"
            android:src="@drawable/ic_sticker"
            android:contentDescription="@string/story_ed_done" />

        <ImageView
            android:id="@+id/btn_editor_music"
            style="@style/Widget.Insta.StoryCircleButton"
            android:layout_marginStart="@dimen/story_ed_top_gap"
            android:src="@drawable/ic_music"
            android:contentDescription="@string/story_ed_done" />

        <ImageView
            android:id="@+id/btn_editor_more"
            style="@style/Widget.Insta.StoryCircleButton"
            android:layout_marginStart="@dimen/story_ed_top_gap"
            android:src="@drawable/ic_more_horiz"
            android:contentDescription="@string/story_vw_more" />
    </LinearLayout>

    <!-- Canvas card + tooltip. Card width/height are set in Java (width - 56dp, 9:16). -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/card_editor"
            android:layout_width="300dp"
            android:layout_height="500dp"
            android:background="@drawable/bg_story_card"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/your_story" />

            <com.insta.nova.ui.widget.OverlayDrawView
                android:id="@+id/overlay_draw"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/overlay_text_host"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layout_tooltip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/story_ed_tooltip_gap"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <View
                android:id="@+id/view_tooltip_caret"
                android:layout_width="@dimen/story_ed_caret_size"
                android:layout_height="@dimen/story_ed_caret_size"
                android:background="@drawable/bg_story_caret" />

            <TextView
                android:id="@+id/tv_tooltip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_story_tooltip"
                android:paddingStart="@dimen/story_ed_tooltip_pad_h"
                android:paddingEnd="@dimen/story_ed_tooltip_pad_h"
                android:paddingTop="@dimen/story_ed_tooltip_pad_v"
                android:paddingBottom="@dimen/story_ed_tooltip_pad_v"
                android:text="@string/story_ed_tooltip_tap_size"
                android:textAppearance="@style/TextAppearance.Insta.StoryTooltip" />
        </LinearLayout>
    </LinearLayout>

    <!-- Text drag-to-delete target. -->
    <ImageView
        android:id="@+id/iv_trash_target"
        android:layout_width="@dimen/story_ed_trash"
        android:layout_height="@dimen/story_ed_trash"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/story_ed_panel_height"
        android:background="@drawable/bg_story_scrim_circle"
        android:padding="10dp"
        android:src="@drawable/ic_trash"
        android:visibility="gone"
        android:contentDescription="@string/story_ed_delete_hint" />

    <!-- Draw panel: 6 pen colours + size slider + undo + done. -->
    <LinearLayout
        android:id="@+id/panel_draw"
        android:layout_width="match_parent"
        android:layout_height="@dimen/story_ed_panel_height"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/story_ed_top_margin"
        android:paddingEnd="@dimen/story_ed_top_margin"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot_color_1"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:background="@drawable/bg_story_color_dot" />

            <View
                android:id="@+id/dot_color_2"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:layout_marginStart="@dimen/story_ed_dot_gap"
                android:background="@drawable/bg_story_color_dot" />

            <View
                android:id="@+id/dot_color_3"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:layout_marginStart="@dimen/story_ed_dot_gap"
                android:background="@drawable/bg_story_color_dot" />

            <View
                android:id="@+id/dot_color_4"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:layout_marginStart="@dimen/story_ed_dot_gap"
                android:background="@drawable/bg_story_color_dot" />

            <View
                android:id="@+id/dot_color_5"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:layout_marginStart="@dimen/story_ed_dot_gap"
                android:background="@drawable/bg_story_color_dot" />

            <View
                android:id="@+id/dot_color_6"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:layout_marginStart="@dimen/story_ed_dot_gap"
                android:background="@drawable/bg_story_color_dot" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/story_ed_bottom_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/seek_stroke"
                android:layout_width="@dimen/story_ed_slider_width"
                android:layout_height="@dimen/story_ed_slider_height" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btn_draw_undo"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:src="@drawable/ic_undo"
                android:contentDescription="@string/story_ed_undo" />

            <TextView
                android:id="@+id/btn_draw_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/story_ed_dot_gap"
                android:text="@string/story_ed_done"
                android:textAppearance="@style/TextAppearance.Insta.StoryPill" />
        </LinearLayout>
    </LinearLayout>

    <!-- Text panel: 6 colours + bold + done. -->
    <LinearLayout
        android:id="@+id/panel_text"
        android:layout_width="match_parent"
        android:layout_height="@dimen/story_ed_panel_height"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/story_ed_top_margin"
        android:paddingEnd="@dimen/story_ed_top_margin"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/text_dot_1"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:background="@drawable/bg_story_color_dot" />

            <View
                android:id="@+id/text_dot_2"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:layout_marginStart="@dimen/story_ed_dot_gap"
                android:background="@drawable/bg_story_color_dot" />

            <View
                android:id="@+id/text_dot_3"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:layout_marginStart="@dimen/story_ed_dot_gap"
                android:background="@drawable/bg_story_color_dot" />

            <View
                android:id="@+id/text_dot_4"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:layout_marginStart="@dimen/story_ed_dot_gap"
                android:background="@drawable/bg_story_color_dot" />

            <View
                android:id="@+id/text_dot_5"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:layout_marginStart="@dimen/story_ed_dot_gap"
                android:background="@drawable/bg_story_color_dot" />

            <View
                android:id="@+id/text_dot_6"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:layout_marginStart="@dimen/story_ed_dot_gap"
                android:background="@drawable/bg_story_color_dot" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/story_ed_bottom_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_text_bold"
                android:layout_width="@dimen/story_ed_dot"
                android:layout_height="@dimen/story_ed_dot"
                android:background="@drawable/bg_story_color_dot"
                android:gravity="center"
                android:text="@string/story_ed_aa"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_text_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/story_ed_done"
                android:textAppearance="@style/TextAppearance.Insta.StoryPill" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom row: Your story + Close Friends + next arrow. -->
    <LinearLayout
        android:id="@+id/layout_editor_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/story_ed_bottom_height"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/story_ed_bottom_margin"
        android:paddingStart="@dimen/story_ed_bottom_margin"
        android:paddingEnd="@dimen/story_ed_bottom_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnPublish"
            android:layout_width="0dp"
            android:layout_height="@dimen/story_ed_bottom_height"
            android:layout_weight="1"
            android:background="@drawable/bg_story_pill"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/story_ed_top_gap"
            android:paddingEnd="@dimen/story_ed_top_gap"
            android:orientation="horizontal">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_editor_avatar"
                android:layout_width="@dimen/story_ed_pill_avatar"
                android:layout_height="@dimen/story_ed_pill_avatar"
                android:src="@drawable/ic_person_placeholder" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/story_ed_pill_text_start"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/your_story"
                android:textAppearance="@style/TextAppearance.Insta.StoryPill" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pill_close_friends"
            android:layout_width="0dp"
            android:layout_height="@dimen/story_ed_bottom_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/story_ed_bottom_gap"
            android:background="@drawable/bg_story_pill"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/story_ed_top_gap"
            android:paddingEnd="@dimen/story_ed_top_gap"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/story_ed_pill_avatar"
                android:layout_height="@dimen/story_ed_pill_avatar"
                android:background="@drawable/bg_story_close_friends">

                <ImageView
                    android:layout_width="@dimen/story_ed_pill_icon"
                    android:layout_height="@dimen/story_ed_pill_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_star"
                    android:contentDescription="@string/story_ed_close_friends" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/story_ed_pill_text_start"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/story_ed_close_friends"
                android:textAppearance="@style/TextAppearance.Insta.StoryPill" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_editor_next"
            android:layout_width="@dimen/story_ed_arrow"
            android:layout_height="@dimen/story_ed_arrow"
            android:layout_marginStart="@dimen/story_ed_bottom_gap"
            android:background="@drawable/bg_story_next_circle"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/black"
            android:contentDescription="@string/picker_next" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
