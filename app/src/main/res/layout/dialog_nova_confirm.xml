<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nova_card"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/confirmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/nova_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/confirmMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.25"
        android:textColor="@color/nova_text_2"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnConfirm"
        style="@style/Widget.Nova.Button.Danger"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nova_button_height"
        android:layout_marginTop="18dp"
        android:text="@string/nova_block" />

    <Button
        android:id="@+id/btnCancel"
        style="@style/Widget.Nova.Button.Ghost"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:text="@string/nova_cancel" />
</LinearLayout>
