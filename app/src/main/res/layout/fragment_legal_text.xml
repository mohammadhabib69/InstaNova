<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollable in-app policy text (Terms / Privacy Policy / Cookies Policy). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topbar"
        layout="@layout/view_wizard_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/auth_side_padding"
            android:paddingEnd="@dimen/auth_side_padding"
            android:paddingBottom="@dimen/auth_paragraph_gap">

            <TextView
                android:id="@+id/tv_legal_title"
                style="@style/TextAppearance.Insta.AuthTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_title_gap" />

            <TextView
                android:id="@+id/tv_legal_body"
                style="@style/TextAppearance.Insta.AuthSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_subtitle_gap"
                android:textColor="@color/auth_text_secondary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
