<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackground"
    android:paddingHorizontal="24dp">

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="?attr/themeTextPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Back" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/signup_title_birthday"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="@dimen/text_auth_title"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivBack" />

    <TextView
        android:id="@+id/tvBirthdayDisplay"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_field_height"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="@dimen/text_body"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <TextView
        android:id="@+id/tvAgeError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/signup_error_age"
        android:textColor="@color/color_destructive"
        android:textSize="@dimen/text_meta"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvBirthdayDisplay" />

    <DatePicker
        android:id="@+id/datePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:calendarViewShown="false"
        android:datePickerMode="spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAgeError" />

    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_auth_height"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_button_primary"
        android:text="@string/next"
        android:textColor="@color/white"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/datePicker" />

</androidx.constraintlayout.widget.ConstraintLayout>
