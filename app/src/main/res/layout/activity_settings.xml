<?xml version="1.0" encoding="utf-8"?>
<!-- PAGE 13 — Settings and activity: 56dp bar, search field, sectioned rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/settings_row_pad_h"
        android:paddingEnd="@dimen/settings_row_pad_h">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/settings_back_icon"
            android:layout_height="@dimen/settings_back_icon"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/settings_cancel"
            app:tint="?attr/themeTextPrimary" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/settings_row_icon_gap"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.Insta.SettingsTitle" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/settings_search_height"
        android:layout_marginStart="@dimen/settings_search_margin"
        android:layout_marginEnd="@dimen/settings_search_margin"
        android:background="@drawable/bg_search_field"
        android:backgroundTint="?attr/themeSurfaceVariant">

        <ImageView
            android:layout_width="@dimen/settings_search_icon"
            android:layout_height="@dimen/settings_search_icon"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/settings_row_value_gap"
            android:src="@drawable/ic_search"
            android:contentDescription="@null"
            app:tint="?attr/themeTextSecondary" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="@string/settings_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="32dp"
            android:paddingEnd="@dimen/settings_row_value_gap"
            android:textAppearance="@style/TextAppearance.Insta.SettingsLabel"
            android:textColorHint="?attr/themeTextSecondary" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_no_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/settings_empty_pad"
        android:gravity="center"
        android:text="@string/settings_no_results"
        android:textAppearance="@style/TextAppearance.Insta.SettingsValue"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/settings_section_gap"
        android:scrollbars="none" />
</LinearLayout>
