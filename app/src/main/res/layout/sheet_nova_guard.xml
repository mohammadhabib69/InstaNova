<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_nova_sheet"
    android:orientation="vertical"
    android:padding="22dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@color/nova_stroke" />

    <ImageView
        android:id="@+id/guardIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_shield_alert" />

    <TextView
        android:id="@+id/guardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/nova_text"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/guardMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/nova_text_2"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/guardPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_nova_input"
        android:lineSpacingMultiplier="1.25"
        android:padding="14dp"
        android:textColor="@color/nova_text"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnEdit"
        style="@style/Widget.Nova.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nova_button_height"
        android:layout_marginTop="16dp"
        android:text="@string/nova_edit" />

    <Button
        android:id="@+id/btnPostAnyway"
        style="@style/Widget.Nova.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nova_button_height"
        android:layout_marginTop="8dp"
        android:text="@string/nova_post_anyway" />
</LinearLayout>
