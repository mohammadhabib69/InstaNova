<?xml version="1.0" encoding="utf-8"?>
<!--
    A Nova post with its comment thread.

    The post card is the same card the feed uses; below it the threaded
    comments, and at the bottom the composer for a new comment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/novaDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnNovaDetailBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/themeTextPrimary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="@string/nova_comments_title"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/novaDetailProgress"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="?attr/themeTextSecondary"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_hairline"
        android:background="?attr/themeDivider" />

    <!-- The post, the same card the feed shows. -->
    <include
        android:id="@+id/novaDetailPost"
        layout="@layout/item_nova_post" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_hairline"
        android:layout_marginTop="6dp"
        android:background="?attr/themeDivider" />

    <!-- The comment thread. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/novaCommentList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/tvNovaCommentsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:text="@string/nova_comments_empty"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNovaCommentsError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:textColor="?attr/themeTextSecondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- The comment composer. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_hairline"
        android:background="?attr/themeDivider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etNovaCommentBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_nova_input"
            android:hint="@string/nova_comments_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="42dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="?attr/themeTextPrimary"
            android:textColorHint="?attr/themeTextSecondary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchNovaCommentAnonymous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/nova_comments_anonymous" />

        <ImageButton
            android:id="@+id/btnNovaCommentSend"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nova_comments_send"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            app:tint="@color/color_primary" />
    </LinearLayout>

    <!-- Which comment the next message replies to. -->
    <TextView
        android:id="@+id/tvNovaReplyTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/themeSurfaceVariant"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textColor="?attr/themeTextSecondary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
