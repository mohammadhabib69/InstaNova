<?xml version="1.0" encoding="utf-8"?>
<!-- PAGE 17 — CHAT. Header 52dp directly under status bar, scrolling conversation, pinned input bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackground"
    android:orientation="vertical">

    <!-- ================= Header ================= -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/chat_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/chat_header_padding_horizontal"
        android:paddingEnd="@dimen/chat_header_padding_horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/chat_back_icon"
            android:layout_height="@dimen/chat_back_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/themeTextPrimary" />

        <LinearLayout
            android:id="@+id/layoutHeaderUser"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/chat_header_avatar_gap"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHeaderAvatar"
                android:layout_width="@dimen/chat_header_avatar"
                android:layout_height="@dimen/chat_header_avatar"
                android:contentDescription="Profile"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chat_header_text_gap"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHeaderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="@dimen/chat_header_name_size" />

                <TextView
                    android:id="@+id/tvHeaderStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/chat_text_secondary"
                    android:textSize="@dimen/chat_header_status_size"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Header Action: Audio Call (Phone icon) -->
        <ImageView
            android:id="@+id/btnAudioCall"
            android:layout_width="@dimen/chat_header_action"
            android:layout_height="@dimen/chat_header_action"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Audio call"
            android:src="@drawable/ic_phone_call"
            app:tint="?attr/themeTextPrimary" />

        <!-- Header Action: Video Call (Camera icon) -->
        <ImageView
            android:id="@+id/btnVideoCall"
            android:layout_width="@dimen/chat_header_action"
            android:layout_height="@dimen/chat_header_action"
            android:layout_marginStart="@dimen/chat_header_action_gap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Video call"
            android:src="@drawable/ic_video"
            app:tint="?attr/themeTextPrimary" />

        <!-- Header Action: Chat Details (Info icon) -->
        <ImageView
            android:id="@+id/btnDetails"
            android:layout_width="@dimen/chat_header_action"
            android:layout_height="@dimen/chat_header_action"
            android:layout_marginStart="@dimen/chat_header_action_gap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Chat details"
            android:src="@drawable/ic_info"
            app:tint="?attr/themeTextPrimary" />

    </LinearLayout>

    <!-- In-conversation search bar (opened from Chat Details or search mode) -->
    <LinearLayout
        android:id="@+id/layoutSearchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#1C1C1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/chat_text_secondary" />

        <EditText
            android:id="@+id/etSearchConversation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search conversation..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="?attr/themeTextPrimary"
            android:textColorHint="@color/chat_text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvSearchCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/chat_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnCloseSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close search"
            android:src="@drawable/ic_close"
            app:tint="?attr/themeTextPrimary" />
    </LinearLayout>

    <!-- ================= Conversation ================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <!-- ================= Reply Preview Bar ================= -->
    <LinearLayout
        android:id="@+id/layoutReplyBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#202020"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <View
            android:layout_width="3dp"
            android:layout_height="28dp"
            android:background="@color/color_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReplyTargetUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReplyTargetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/chat_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCancelReply"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancel reply"
            android:src="@drawable/ic_close"
            app:tint="@color/chat_text_secondary" />
    </LinearLayout>

    <!-- ================= Input bar ================= -->
    <LinearLayout
        android:id="@+id/layoutInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/chat_input_margin">

        <!-- Active Voice Recording State -->
        <LinearLayout
            android:id="@+id/layoutRecording"
            android:layout_width="match_parent"
            android:layout_height="@dimen/chat_input_height"
            android:background="@drawable/bg_chat_input_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivRecordingDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/bg_notification_dot" />

            <TextView
                android:id="@+id/tvRecordingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="0:00"
                android:textColor="@color/color_destructive"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Recording voice note..."
                android:textColor="@color/chat_text_secondary"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnCancelRecording"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cancel recording"
                android:src="@drawable/ic_trash"
                app:tint="@color/color_destructive" />

            <ImageView
                android:id="@+id/btnStopAndSendRecording"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Send recording"
                android:src="@drawable/ic_send"
                app:tint="@color/color_primary" />
        </LinearLayout>

        <!-- Standard Input Bar -->
        <LinearLayout
            android:id="@+id/layoutInputBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/chat_input_height"
            android:background="@drawable/bg_chat_input_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnCamera"
                android:layout_width="@dimen/chat_input_camera_circle"
                android:layout_height="@dimen/chat_input_camera_circle"
                android:layout_marginStart="@dimen/chat_input_camera_margin_start"
                android:background="@drawable/bg_chat_camera_circle"
                android:contentDescription="Camera">

                <ImageView
                    android:layout_width="@dimen/chat_input_camera_icon"
                    android:layout_height="@dimen/chat_input_camera_icon"
                    android:layout_gravity="center"
                    android:contentDescription="Camera"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/white" />
            </FrameLayout>

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="Message..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textAutoCorrect"
                android:maxLength="1000"
                android:maxLines="1"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="?attr/themeTextPrimary"
                android:textColorHint="@color/chat_text_secondary"
                android:textSize="@dimen/chat_input_hint_size" />

            <!-- Mic button for voice recording -->
            <ImageView
                android:id="@+id/btnMic"
                android:layout_width="@dimen/chat_input_icon"
                android:layout_height="@dimen/chat_input_icon"
                android:layout_marginEnd="@dimen/chat_input_icon_gap"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Voice message"
                android:src="@drawable/ic_mic"
                app:tint="?attr/themeTextPrimary" />

            <!-- Gallery/Image button -->
            <ImageView
                android:id="@+id/btnGallery"
                android:layout_width="@dimen/chat_input_icon"
                android:layout_height="@dimen/chat_input_icon"
                android:layout_marginEnd="@dimen/chat_input_icon_gap"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Gallery"
                android:src="@drawable/ic_gallery"
                app:tint="?attr/themeTextPrimary" />

            <!-- Emoji Picker button (replaces star) -->
            <ImageView
                android:id="@+id/btnEmojiPicker"
                android:layout_width="@dimen/chat_input_icon"
                android:layout_height="@dimen/chat_input_icon"
                android:layout_marginEnd="@dimen/chat_input_icon_gap"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Emoji"
                android:src="@drawable/ic_smiley"
                app:tint="?attr/themeTextPrimary" />

            <!-- '+' Expand/More Actions button -->
            <ImageView
                android:id="@+id/btnAddCircle"
                android:layout_width="@dimen/chat_input_icon"
                android:layout_height="@dimen/chat_input_icon"
                android:layout_marginEnd="@dimen/chat_input_icon_end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More"
                android:src="@drawable/ic_add_circle"
                app:tint="?attr/themeTextPrimary" />

            <TextView
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="Send"
                android:textColor="@color/chat_accent"
                android:textSize="@dimen/chat_input_send_size"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <!-- Emoji Picker Bottom Panel -->
    <LinearLayout
        android:id="@+id/layoutEmojiPicker"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#161616"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEmojiPicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />
    </LinearLayout>

</LinearLayout>
