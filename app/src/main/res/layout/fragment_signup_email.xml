<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/themeBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="36dp" android:paddingBottom="24dp">
        <TextView android:id="@+id/tvWordmark" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Instagram" android:textColor="?attr/themeTextPrimary" android:textSize="48sp" />
        <TextView android:id="@+id/tvSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Sign up to see photos and videos from your friends." android:textColor="?attr/themeTextSecondary" android:textSize="16sp" android:textStyle="bold" />
        <Button android:id="@+id/btnFacebook" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="16dp" android:background="@drawable/bg_button_primary" android:text="Log in with Facebook" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:stateListAnimator="@null" />
        <LinearLayout android:id="@+id/facebookDivider" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="?attr/themeDivider" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:text="OR" android:textColor="?attr/themeTextSecondary" android:textSize="13sp" /><View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="?attr/themeDivider" />
        </LinearLayout>
        <EditText android:id="@+id/etEmail" style="@style/InstaAuthField" android:hint="Mobile Number or Email" android:inputType="textEmailAddress" />
        <TextView android:id="@+id/tvEmailError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/color_destructive" android:textSize="12sp" android:visibility="gone" />
        <EditText android:id="@+id/etFullName" style="@style/InstaAuthField" android:hint="Full Name" android:layout_marginTop="6dp" android:inputType="textCapWords" />
        <EditText android:id="@+id/etUsername" style="@style/InstaAuthField" android:hint="Username" android:layout_marginTop="6dp" android:inputType="text" />
        <TextView android:id="@+id/tvUsernameError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/color_destructive" android:textSize="12sp" android:visibility="gone" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp">
            <EditText android:id="@+id/etPassword" style="@style/InstaAuthField" android:layout_width="match_parent" android:layout_height="match_parent" android:hint="Password" android:inputType="textPassword" android:paddingEnd="48dp" />
            <ImageView android:id="@+id/ivPasswordToggle" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="12dp" android:src="@drawable/ic_visibility" android:contentDescription="Toggle password visibility" />
        </FrameLayout>
        <TextView android:id="@+id/tvInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="People who use our service may have uploaded your contact information to Instagram. Learn More" android:textColor="?attr/themeTextSecondary" android:textSize="12sp" />
        <TextView android:id="@+id/tvTerms" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="By signing up, you agree to our Terms, Privacy Policy and Cookies Policy." android:textColor="?attr/themeTextSecondary" android:textSize="12sp" />
        <Button android:id="@+id/btnSignUp" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="16dp" android:background="@drawable/bg_button_primary" android:text="Sign up" android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold" android:stateListAnimator="@null" />
        <ProgressBar android:id="@+id/progressBar" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:visibility="gone" />
        <TextView android:id="@+id/tvLogin" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="16dp" android:background="@drawable/bg_button_outline" android:gravity="center" android:text="Have an account? Log in" android:textColor="?attr/themePrimary" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
