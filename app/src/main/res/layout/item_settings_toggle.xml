<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutToggleRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/settings_row_pad_h"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/settings_row_pad_h"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvToggleLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Insta.SettingsLabel" />

        <TextView
            android:id="@+id/tvToggleDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Insta.SettingsDesc"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchToggle"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:minWidth="0dp"
        app:showText="false"
        app:useMaterialThemeColors="false" />
</LinearLayout>
