<?xml version="1.0" encoding="utf-8"?>
<!--
    The sort selector popup. It is anchored under the sort chip, so unlike a
    bottom sheet it needs rounded corners on every side and a hairline edge
    to separate it from the feed behind it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/color_sheet" />
    <stroke android:width="@dimen/divider_hairline" android:color="@color/nova_stroke" />
    <corners android:radius="@dimen/nova_radius_chip" />
</shape>
