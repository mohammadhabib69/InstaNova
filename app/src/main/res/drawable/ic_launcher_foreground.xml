        android:pivotX="12"
        android:pivotY="12"
        android:translateX="42"
        android:translateY="42"
        android:scaleX="1.8"
        android:scaleY="1.8">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M12 2 C12.6 7.4 16.6 11.4 22 12 C16.6 12.6 12.6 16.6 12 22 C11.4 16.6 7.4 12.6 2 12 C7.4 11.4 11.4 7.4 12 2 Z" />
