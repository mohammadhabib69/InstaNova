<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top|center_horizontal">
        <rotate android:fromDegrees="45" android:toDegrees="45" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="@color/white" />
                <size android:width="@dimen/story_ed_caret_size" android:height="@dimen/story_ed_caret_size" />
            </shape>
        </rotate>
    </item>
</layer-list>
