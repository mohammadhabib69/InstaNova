<?xml version="1.0" encoding="utf-8"?>
<!-- 'Remember login info' checkbox: blue with a white tick when checked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/auth_checkbox" />
                    <corners android:radius="@dimen/auth_checkbox_radius" />
                </shape>
            </item>
            <item
                android:drawable="@drawable/ic_check"
                android:gravity="center"
                android:width="16dp"
                android:height="16dp" />
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/auth_code_box_bg" />
            <corners android:radius="@dimen/auth_checkbox_radius" />
            <stroke
                android:width="@dimen/auth_field_stroke"
                android:color="@color/auth_checkbox_border" />
        </shape>
    </item>
</selector>
